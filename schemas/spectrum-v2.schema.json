{
  "type": "object",
  "properties": {
    "format": {
      "const": "schemock"
    },
    "schema_version": {
      "const": 2
    },
    "diagram_kind": {
      "const": "spectrum"
    },
    "figure_id": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "selected_variant_id": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "coordinate_system": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "top-left"
        },
        "x_axis": {
          "const": "right"
        },
        "y_axis": {
          "const": "down"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 10000000.0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 10000000.0
        },
        "unit": {
          "const": "draft-unit"
        }
      },
      "required": [
        "origin",
        "x_axis",
        "y_axis",
        "width",
        "height",
        "unit"
      ],
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1
          },
          "initial": {
            "$ref": "#/$defs/scene"
          },
          "current": {
            "$ref": "#/$defs/scene"
          }
        },
        "required": [
          "id",
          "title",
          "initial",
          "current"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1,
          "format": "date-time"
        },
        "app_version": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1
        }
      },
      "required": [
        "id",
        "exported_at",
        "app_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "schema_version",
    "diagram_kind",
    "figure_id",
    "base_revision",
    "selected_variant_id",
    "coordinate_system",
    "variants"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryo-araki.github.io/schemock/schemas/spectrum-v2.schema.json",
  "$defs": {
    "scene": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 10000,
                "minLength": 1
              },
              "type": {
                "enum": [
                  "polyline",
                  "cubic"
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "exclusiveMinimum": -10000000.0,
                      "exclusiveMaximum": 10000000.0
                    },
                    "y": {
                      "type": "number",
                      "exclusiveMinimum": -10000000.0,
                      "exclusiveMaximum": 10000000.0
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 1000
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 10000000.0
              },
              "directed": {
                "type": "boolean"
              },
              "dash": {
                "type": "boolean"
              },
              "stroke": {
                "anyOf": [
                  {
                    "enum": [
                      "black",
                      "gray",
                      "silver",
                      "white",
                      "navy",
                      "blue",
                      "aqua",
                      "teal",
                      "eastern",
                      "purple",
                      "fuchsia",
                      "maroon",
                      "red",
                      "orange",
                      "yellow",
                      "olive",
                      "green",
                      "lime"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                ]
              }
            },
            "required": [
              "id",
              "type",
              "points",
              "width",
              "directed",
              "dash"
            ],
            "additionalProperties": false
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 10000,
                "minLength": 1
              },
              "x": {
                "type": "number",
                "exclusiveMinimum": -10000000.0,
                "exclusiveMaximum": 10000000.0
              },
              "y": {
                "type": "number",
                "exclusiveMinimum": -10000000.0,
                "exclusiveMaximum": 10000000.0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 10000000.0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 10000000.0
              },
              "fill": {
                "anyOf": [
                  {
                    "enum": [
                      "black",
                      "gray",
                      "silver",
                      "white",
                      "navy",
                      "blue",
                      "aqua",
                      "teal",
                      "eastern",
                      "purple",
                      "fuchsia",
                      "maroon",
                      "red",
                      "orange",
                      "yellow",
                      "olive",
                      "green",
                      "lime"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                ]
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 10000,
                "minLength": 1
              },
              "x": {
                "type": "number",
                "exclusiveMinimum": -10000000.0,
                "exclusiveMaximum": 10000000.0
              },
              "y": {
                "type": "number",
                "exclusiveMinimum": -10000000.0,
                "exclusiveMaximum": 10000000.0
              },
              "text": {
                "type": "string",
                "maxLength": 10000
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 10000000.0
              },
              "fill": {
                "anyOf": [
                  {
                    "enum": [
                      "black",
                      "gray",
                      "silver",
                      "white",
                      "navy",
                      "blue",
                      "aqua",
                      "teal",
                      "eastern",
                      "purple",
                      "fuchsia",
                      "maroon",
                      "red",
                      "orange",
                      "yellow",
                      "olive",
                      "green",
                      "lime"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                ]
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "text",
              "fontSize"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "paths",
        "regions",
        "labels"
      ],
      "additionalProperties": false
    }
  }
}
